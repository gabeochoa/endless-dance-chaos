# Lineup booking + festival tiers (RCT growth).
# Acts: bookable for the NEXT day, fee paid now, refused when broke or
# locked. Tiers: f(cumulative attendees) 0 Local Fair -> 1 Regional ->
# 2 National -> 3 Legendary at 500 / 2000 / 8000 attendees.
reset_game
set_spawn_enabled 0
wait_frames 2

# --- HUD: tier + booking panel, tier 0 defaults ---
expect_text "Tier: Local Fair"
expect_text "BOOK ACTS"
assert_festival_tier eq 0
assert_spawn_cap eq 200
assert_lineup_draw eq 1.0
assert_lineup_fun eq 1.0
assert_booked_count eq 0
assert_active_count eq 0

# --- (1) Broke refusal: fee kept, nothing booked ---
set_cash 100
wait_frames 2
book_act cardboard
wait_frames 2
assert_cash eq 100
assert_booked_count eq 0
assert_toast_contains "Not enough cash"

# --- (2) Locked act refused at tier 0 ---
set_cash 10000
wait_frames 2
book_act moldy
wait_frames 2
assert_cash eq 10000
assert_booked_count eq 0
assert_toast_contains "Locked"

# --- (1) Book an act: fee deducted, booked for tomorrow, not yet active ---
assert_cash eq 10000
book_act cardboard
wait_frames 2
assert_cash eq 9500
assert_booked_count eq 1
assert_booked_act cardboard
assert_active_count eq 0
assert_lineup_draw eq 1.0
assert_toast_contains "Booked"
expect_text "Next: Cardboard"

# Duplicate booking refused, no second charge
book_act cardboard
wait_frames 2
assert_cash eq 9500
assert_booked_count eq 1
assert_toast_contains "Already booked"

# --- (1) Panel click books a second act: switch to the Lineup tab
# first (tab centre 1254,145), then row 1 button centre 1248,402 ---
click 1254 145
wait_frames 2
assert_window_tab lineup
click 1248 402
wait_frames 3
assert_cash eq 8700
assert_booked_count eq 2
assert_booked_act poets

# --- (1) Rollover: booked -> active, draw/fun apply, fee NOT charged again ---
# set_day_number 2 also runs the daily inspection (clean record, tier 0:
# +$500), so cash is 8700 + 500 = 9200, not 8700 - 1300.
set_day_number 2
wait_frames 5
assert_day_number eq 2
assert_cash eq 9200
assert_booked_count eq 0
assert_active_count eq 2
assert_active_act cardboard
assert_active_act poets
assert_lineup_draw eq 1.65
assert_lineup_fun eq 1.55
assert_spawn_interval eq 1.054
assert_toast_contains "On stage today"

# --- (1) Acts expire after their day ---
set_day_number 3
wait_frames 5
assert_active_count eq 0
assert_lineup_draw eq 1.0
assert_lineup_fun eq 1.0
assert_spawn_interval eq 1.538
assert_cash eq 9700

# --- (1) Control day: same day, no act -> spawn interval is higher ---
reset_game
set_spawn_enabled 0
wait_frames 2
set_day_number 2
wait_frames 5
assert_spawn_interval eq 1.739
assert_lineup_draw eq 1.0

# --- (2) Tier-up at the 500-attendee threshold unlocks the act + ticker ---
reset_game
set_spawn_enabled 0
wait_frames 2
assert_festival_tier eq 0
book_act moldy
wait_frames 2
assert_booked_count eq 0
assert_toast_contains "Locked"
add_arrivals 500
wait_frames 5
assert_festival_tier eq 1
expect_text "Tier: Regional"
assert_act_unlocked moldy
assert_spawn_cap eq 225
assert_toast_contains "TIER UP"
expect_text "TIER UP"
book_act moldy
wait_frames 2
assert_booked_count eq 1
assert_booked_act moldy
assert_cash eq 8800

# --- (2) Inspection grant scales with tier: A = $500 * (1 + tier) ---
reset_game
set_spawn_enabled 0
wait_frames 2
assert_cash eq 10000
run_inspection
wait_frames 5
assert_inspection_grade A
assert_cash eq 10500

reset_game
set_spawn_enabled 0
wait_frames 2
add_arrivals 500
wait_frames 5
assert_festival_tier eq 1
run_inspection
wait_frames 5
assert_inspection_grade A
assert_cash eq 11000
