# Test rain event: triggers, slows agents, expires
reset_game
set_spawn_enabled 0
wait_frames 5

# No events active initially
assert_event_inactive rain

# Trigger a short rain event (2 seconds; expiry is the transition
# that matters, and the 1s wait margin is in the same dt units the
# event timer advances in)
trigger_event rain 2

# Rain should be active
assert_event_active rain

# Toast should announce the event
assert_toast_contains rain

# Wait for event to expire
wait 3

# Rain should be gone
assert_event_inactive rain
