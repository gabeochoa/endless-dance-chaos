# Campaign scenarios (RCT goals): Park-tab selection, live objective
# checklist, WON (banner + ticker + cash prize) / FAILED (banner,
# sandbox continues), Tycoon earned counter, save/load persistence.
#
# Scenario table (components.h): First Weekend = 300 attendees +
# rating 600 in 3 days, no deaths, prize $5000, starting cash $10000.
# Tycoon = $50000 earned in 5 days, prize $10000, starting cash $15000.
# Safety Record = survive 4 days, 0 deaths, B+ inspection once, prize
# $7500, starting cash $8000. Deadline = start_day + duration_days.
# Selecting restarts objective tracking (not the park) and applies the
# starting cash. Cash math below counts the inspection grants that
# fire when a day jump crosses into a new day (clean record -> A -> $500).
reset_game
set_spawn_enabled 0
wait_frames 2

# --- No scenario at first; Park tab shows the scenario rows ---
set_window_tab park
wait_frames 2
assert_scenario_status none
assert_scenario_id none
expect_text "SCENARIOS"
expect_text "First Weekend"
expect_text "Tycoon"
expect_text "Safety Record"
expect_text "Scenario: None"
expect_text "No scenario selected."

# --- First Weekend: select via the Park-tab SELECT button ---
# Row 0 button centre (1240, 281): x 1212..1268, y 272..290.
click 1240 281
wait_frames 2
assert_scenario_id first_weekend
assert_scenario_status active
assert_cash eq 10000
expect_text "Scenario: First Weekend - Active"
expect_text "Attendees: 0/300"
# Rating peak is the live rating (500 after a reset) from the first
# update after selection — not 0 — so assert the stable post-select
# value; the transient 0 only exists on the click frame itself.
expect_text "Rating: 500/600"
expect_text "No deaths"
expect_text "Deadline: Day 4"

# --- First Weekend WON: 300 live attendees + rating 600 ---
# 12 x 25 spread spawns (25/tile stays under the 36 crush threshold;
# the win lands within frames, long before anyone converges).
spawn_agents 10 10 25 stage
spawn_agents 10 40 25 stage
spawn_agents 40 10 25 stage
spawn_agents 40 40 25 stage
spawn_agents 10 25 25 stage
spawn_agents 40 25 25 stage
spawn_agents 25 10 25 stage
spawn_agents 25 40 25 stage
spawn_agents 15 15 25 stage
spawn_agents 35 35 25 stage
spawn_agents 15 35 25 stage
spawn_agents 35 15 25 stage
wait_frames 2
assert_agent_count eq 300
set_park_rating 600
wait_frames 3
assert_scenario_status won
assert_toast_contains "SCENARIO WON"
expect_text "SCENARIO WON"
assert_cash eq 15000
assert_total_earned eq 5000
# Let the rating decay below 600 so a re-select does not instantly re-win.
wait 1

# --- Re-selecting restarts tracking (not the park) ---
select_scenario first_weekend
wait_frames 2
assert_scenario_status active
assert_cash eq 10000
# The park was NOT restarted: the 300 agents are still there.
assert_agent_count eq 300

# --- First Weekend FAILED: deadline expiry, sandbox continues ---
reset_game
set_spawn_enabled 0
wait_frames 2
select_scenario first_weekend
wait_frames 2
set_day_number 4
wait_frames 3
assert_scenario_status failed
assert_toast_contains "SCENARIO FAILED"
expect_text "SCENARIO FAILED"
# No prize: $10000 starting cash + $500 day-4 inspection grant (A).
assert_cash eq 10500
# Sandbox continues freely after the failure.
assert_game_status running
spawn_agent 25 25 stage
wait_frames 2
assert_agent_count eq 1

# --- Tycoon: counter accumulates earned; re-select restarts it ---
reset_game
set_spawn_enabled 0
wait_frames 2
select_scenario tycoon
wait_frames 2
assert_scenario_status active
assert_scenario_earned eq 0
assert_cash eq 15000
expect_text "Earned: $0/$50000"
expect_text "Deadline: Day 6"
# Real accumulation: 10 gate arrivals pay $20 each.
spawn_agents 0 26 10 stage
wait_frames 2
assert_scenario_earned eq 200
add_earned 1000
wait_frames 2
assert_scenario_earned eq 1200
# Re-select restarts the counter (and re-applies starting cash).
select_scenario tycoon
wait_frames 2
assert_scenario_status active
assert_scenario_earned eq 0
assert_cash eq 15000
# Tycoon WON: +$50000 earned, +$10000 prize.
# Totals: 1200 banked before the restart + 50000 + 10000 prize = 61200.
add_earned 50000
wait_frames 2
assert_scenario_status won
assert_toast_contains "SCENARIO WON"
assert_cash eq 75000
assert_total_earned eq 61200

# --- Safety Record WON: B+ inspection + survive to the deadline ---
reset_game
set_spawn_enabled 0
wait_frames 2
select_scenario safety_record
wait_frames 2
assert_cash eq 8000
run_inspection
wait_frames 3
assert_inspection_grade A
expect_text "Inspection B+"
set_day_number 5
wait_frames 3
assert_scenario_status won
assert_toast_contains "SCENARIO WON"
# 8000 + 500 forced-inspection grant + 7500 prize + 500 day-5 inspection.
assert_cash eq 16500
assert_total_earned eq 8500

# --- Safety Record FAILED: deadline without a B+ inspection ---
reset_game
set_spawn_enabled 0
wait_frames 2
select_scenario safety_record
wait_frames 2
set_day_number 5
wait_frames 3
assert_scenario_status failed
assert_toast_contains "SCENARIO FAILED"
# 8000 + 500 day-5 inspection grant; no prize.
assert_cash eq 8500
# --- ... and FAILED at once on a death (re-select, then one death) ---
select_scenario safety_record
wait_frames 2
assert_scenario_status active
add_death_count 1
wait_frames 2
assert_scenario_status failed
assert_toast_contains "SCENARIO FAILED"
assert_cash eq 8000

# --- Save/load mid-scenario keeps progress ---
reset_game
set_spawn_enabled 0
wait_frames 2
delete_save
select_scenario tycoon
wait_frames 2
add_earned 2500
wait_frames 2
assert_scenario_earned eq 2500
save_game
assert_save_exists
reset_game
set_spawn_enabled 0
wait_frames 2
assert_scenario_status none
assert_cash eq 10000
load_game
wait_frames 3
assert_scenario_id tycoon
assert_scenario_status active
assert_scenario_earned eq 2500
assert_cash eq 17500
delete_save
reset_game
wait_frames 2
