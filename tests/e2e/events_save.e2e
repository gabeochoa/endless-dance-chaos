# Event director (seeded, 0-2/day, no consecutive repeats) + save/load
# completeness (bookings + staff + economy + tier survive).
# Every event type is forced via trigger_event and its systems effect is
# asserted measurably; the director itself is exercised via set_event_seed
# + roll_events across four days.

# --- Heat Wave: heat growth x2 ---
reset_game
set_spawn_enabled 0
wait_frames 5
spawn_agent 10 10 stage
wait_frames 2
set_heat_threshold 100
set_heat_timer 0
wait 2
# Baseline (no event): ~2.1 (density bonus on a lone tile)
assert_heat_timer gte 1.5
assert_heat_timer lte 3.0
set_heat_timer 0
trigger_event heatwave 30
assert_event_active heatwave
assert_toast_contains "Heat wave"
wait 2
# Heat Wave: ~4.2 (2x growth)
assert_heat_timer gte 3.5
assert_heat_timer lte 5.5

# --- Rain: agents move slower (same 0.5x also slows fleeing) ---
reset_game
set_spawn_enabled 0
set_move_speed 5
wait_frames 5
draw_path_rect 5 26 40 27
wait_frames 5
spawn_agents 5 26 5 stage
wait_frames 5
wait 3
assert_agent_near 12 26 5
trigger_event rain 30
assert_event_active rain
assert_toast_contains "Rain storm"
wait 3
assert_agent_near 16 26 5
# Toast (3s lifetime) is gone by now; only the NEWS ticker still shows
# the announcement text, so this isolates the ticker channel.
wait 1
expect_text "Event: Rain storm!"

# --- Viral Outbreak: illness spreads between nearby agents ---
reset_game
set_spawn_enabled 0
wait_frames 5
spawn_agent 20 20 stage 20 20
spawn_agent 21 20 stage 21 20
wait_frames 2
infect_agent 20 20
assert_needs_heat_count eq 1
trigger_event viraloutbreak 30
assert_event_active viraloutbreak
wait 4
assert_needs_heat_count eq 2

# --- Viral Outbreak: Water Station is more valuable (heals like MedTent) ---
# Control: without the outbreak, water relieves heat but does NOT heal.
reset_game
set_spawn_enabled 0
wait_frames 5
place_building waterstation 25 25
spawn_agent 25 25 stage 25 25
wait_frames 2
set_all_agent_hp 0.5
force_need heat
wait 3
assert_min_agent_hp eq 0.5
# With the outbreak, the same water service restores full HP.
reset_game
set_spawn_enabled 0
wait_frames 5
place_building waterstation 25 25
spawn_agent 25 25 stage 25 25
wait_frames 2
set_all_agent_hp 0.5
force_need heat
trigger_event viraloutbreak 30
assert_event_active viraloutbreak
wait 3
assert_min_agent_hp eq 1.0

# --- Surprise Inspection: inspection runs NOW, mid-day ---
reset_game
set_spawn_enabled 0
wait_frames 5
assert_inspections_done eq 0
set_cash 10000
trigger_event surpriseinspection 0
assert_inspections_done eq 1
assert_inspection_grade A
assert_cash eq 10500
assert_toast_contains "HEALTH INSPECTION"

# --- Generous Sponsor: cash grant scaling with tier ---
reset_game
set_spawn_enabled 0
wait_frames 5
set_cash 10000
trigger_event generoussponsor 0
assert_cash eq 11000
assert_toast_contains "Generous Sponsor"
add_arrivals 500
wait_frames 5
assert_festival_tier eq 1
trigger_event generoussponsor 0
assert_cash eq 13000

# --- Equipment Failure: facility offline, service skipped ---
reset_game
set_spawn_enabled 0
wait_frames 5
trigger_event equipmentfailure 30 bathroom
assert_event_active equipmentfailure
assert_facility_offline bathroom
assert_facility_online food
assert_toast_contains "Equipment Failure"
spawn_agent 20 20 bathroom 20 20
force_need bathroom
wait 3
assert_agents_at_facility bathroom eq 0
assert_agents_on_tiletype bathroom gte 1
# Expiry: short failure goes back online and its event ends.
reset_game
set_spawn_enabled 0
wait_frames 5
trigger_event equipmentfailure 5 bathroom
assert_facility_offline bathroom
wait 6
assert_facility_online bathroom
assert_event_inactive equipmentfailure

# --- Director: seeded, 0-2/day, no repeats on consecutive days ---
# Pinned picks for seed director-seed-7 (deterministic: the director's
# RNG is independent of the shared RandomEngine stream).
reset_game
set_spawn_enabled 0
wait_frames 5
set_event_seed director-seed-7
set_day_number 1
wait_frames 2
roll_events
assert_director_fired_today_count eq 0
assert_director_no_repeat
set_day_number 2
wait_frames 2
roll_events
assert_director_fired_today_count eq 2
assert_event_fired_today rain
assert_event_fired_today surpriseinspection
assert_director_no_repeat
set_day_number 3
wait_frames 2
roll_events
assert_director_fired_today_count eq 2
assert_event_fired_today equipmentfailure
assert_event_fired_today heatwave
assert_director_no_repeat
set_day_number 4
wait_frames 2
roll_events
assert_director_fired_today_count eq 2
assert_event_fired_today generoussponsor
assert_event_fired_today surpriseinspection
assert_director_no_repeat
# Determinism: same seed after a fresh reset reproduces days 1-2.
reset_game
set_spawn_enabled 0
wait_frames 5
set_event_seed director-seed-7
set_day_number 1
wait_frames 2
roll_events
assert_director_fired_today_count eq 0
set_day_number 2
wait_frames 2
roll_events
assert_event_fired_today rain
assert_event_fired_today surpriseinspection
assert_director_no_repeat

# --- Save/load: bookings + staff + economy + tier survive ---
reset_game
set_spawn_enabled 0
wait_frames 5
delete_save
set_cash 10000
add_arrivals 500
wait_frames 5
assert_festival_tier eq 1
book_act cardboard
book_act poets
hire_staff guard 25 23
hire_staff medic 40 40
place_building food 40 10
wait_frames 2
# 10000 - 500 - 800 - 300 - 400 - 500 = 7500; spent = 2500
assert_cash eq 7500
assert_total_earned eq 0
assert_total_spent eq 2500
assert_booked_count eq 2
assert_booked_act cardboard
assert_booked_act poets
assert_staff_count guard eq 1
assert_staff_count medic eq 1
assert_total_arrivals eq 500
assert_festival_tier eq 1
save_game
assert_save_exists
reset_game
set_spawn_enabled 0
wait_frames 2
assert_cash eq 10000
assert_booked_count eq 0
assert_staff_count guard eq 0
assert_staff_count medic eq 0
assert_total_arrivals eq 0
assert_festival_tier eq 0
load_game
wait_frames 5
assert_cash eq 7500
assert_total_earned eq 0
assert_total_spent eq 2500
assert_booked_count eq 2
assert_booked_act cardboard
assert_booked_act poets
assert_staff_count guard eq 1
assert_staff_count medic eq 1
assert_staff_near guard 25 23 3
assert_staff_near medic 40 40 3
assert_total_arrivals eq 500
assert_festival_tier eq 1
assert_tile_type 40 10 food
delete_save
